# Reference only. n8n stores real secrets in its own credential manager.
# Never commit real values.

# Google Sheets
GOOGLE_SHEET_ID=your_sheet_id_here
GOOGLE_SHEET_TAB=Sheet1

# Brevo (transactional email)
BREVO_API_KEY=set_in_n8n_credentials_not_here
BREVO_SENDER_EMAIL=verified_sender@yourdomain.com
BREVO_SENDER_NAME=Your Business Name

# Telegram
TELEGRAM_BOT_TOKEN=set_in_n8n_credentials_not_here
TELEGRAM_CHAT_ID=your_numeric_chat_id

# Tally
TALLY_FORM_ID=your_form_id
